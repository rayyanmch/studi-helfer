{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git stash pop)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm install*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync.sh\"",
            "timeout": 30,
            "statusMessage": "Hole neuesten Stand von GitHub…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync.sh\"",
            "timeout": 30,
            "statusMessage": "Hole neuesten Stand von GitHub…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-push.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
