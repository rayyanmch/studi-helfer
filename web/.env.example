# Kopieren nach .env.local und ausfüllen. .env.local wird nie committet.

# Claude API (console.anthropic.com -> API Keys). Nur serverseitig genutzt.
ANTHROPIC_API_KEY=
# Optional: anderes Modell, z. B. claude-sonnet-5-5 oder claude-haiku-5-5 (günstiger)
AI_MODEL=claude-opus-5-5

# Supabase (Projekt -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL des ILIAS-Sync-Dienstes (services/ilias-sync)
ILIAS_SYNC_URL=http://localhost:8000
